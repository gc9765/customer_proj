#   RISC-V, Makefile, CMake, CubeMX, VSCode
# ===========================================

Objects/
Debug/
Release/
build/
out/
djj/36533_1111_intercom-SERVER/output/
djj/**/obj/
djj/**/bin/
# IDE
djj/36533_1111_intercom-SERVER/project/.cdk/



# -------------------------------
# Build output / object files
# -------------------------------
*.o
*.obj
*.d
*.usm
*.map
*.lst
*.axf
*.elf
*.bin
*.hex
*.out
*.s19
*.srec

# Static analysis or temp build files
*.su
*.idb
*.pdb

# -------------------------------
# Dependency / Autogenerated
# -------------------------------
*.dSYM/
*.dep
*.depend
*.a
*.lib

# Autogenerated CMake files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
build/
out/
Debug/
Release/

# -------------------------------
# IDE Folders
# -------------------------------

# Keil MDK
*.uvguix.*
*.uvoptx
*.uvprojx
*.uvguix
*.sct
Objects/
Listings/

# IAR
*.ewp
*.eww
*.ewd
settings/

# STM32CubeMX
*.ioc
MX_Device/
*.launch
*.project
*.mxproject
Core/Inc/*_mx.h
Core/Src/*_mx.c

# VSCode
.vscode/
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

# JetBrains CLion
.idea/
*.iml

# Eclipse
.metadata/
.settings/

# -------------------------------
# Logs / Temp / OS Files
# -------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db

# -------------------------------
# Python toolchain
# -------------------------------
__pycache__/
*.pyc

# -------------------------------
